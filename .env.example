# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Phase 6) ---
# Settings > API Keys in the Supabase dashboard. The publishable key is
# meant to be public (Row Level Security is what protects the data), but
# NEXT_PUBLIC_ values are baked in at build time, so they must also be set
# as Build variables in Cloudflare, not only as runtime variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses Row Level Security. Server-only; never prefix with NEXT_PUBLIC_,
# never paste into chat. Needed for the RLS test, account deletion and billing.
SUPABASE_SECRET_KEY=

# --- Stripe (Phase 7) ---
# Both are runtime Secrets on the Worker (Variables and Secrets), never
# build variables and never NEXT_PUBLIC_. Test mode keys start sk_test_.
# No price id is configured: the server finds the Premium price by its
# lookup key, creditdash_premium_monthly (lib/billing/stripe.ts).
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_...). Locally, `stripe
# listen` prints its own; the dashboard endpoint has another.
STRIPE_WEBHOOK_SECRET=

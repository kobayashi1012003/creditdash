# Committed on purpose. Next reads this at build time wherever the build
# runs, so Cloudflare's builds get these without depending on dashboard
# build variables, which a Git reconnect can silently reset.
#
# Both values are public by design: they are inlined into the JavaScript
# every visitor downloads, and Row Level Security is what protects the data.
# NEVER add SUPABASE_SECRET_KEY or any other secret here. Secrets are
# runtime-only, set in Cloudflare as type Secret (see .env.example).
NEXT_PUBLIC_SUPABASE_URL=https://wueonwuupzupptfngxou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PKPzUBdh1Gzv6iFedxqTOA_H5_fQjM1
